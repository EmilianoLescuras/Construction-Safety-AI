# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Environments / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert.ipynb

# ── Model Weights (large binaries — never commit) ─────────────────────────────
models/**/*.pt
models/**/*.pth
models/**/*.onnx
models/**/*.engine
models/**/*.torchscript
!models/**/README.md
!models/**/.gitkeep
# Stray pretrained weights downloaded by ultralytics in the project root
*.pt
*.pth
*.onnx
*.engine

# ── Training run artifacts ────────────────────────────────────────────────────
runs/
**/runs/
wandb/
mlruns/
mlartifacts/

# ── Datasets (large — never commit raw or generated data) ─────────────────────
datasets/raw/**/*
datasets/processed/**/*
datasets/train/**/*
datasets/valid/**/*
datasets/test/**/*
!datasets/**/README.md
!datasets/**/.gitkeep

# ── Outputs (generated artifacts) ─────────────────────────────────────────────
outputs/images/**/*
outputs/videos/**/*
outputs/logs/**/*
outputs/*.db
outputs/*.db-journal
outputs/*.sqlite*
!outputs/**/.gitkeep
!outputs/**/README.md

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/**/*
!logs/.gitkeep
*.log

# ── Frontend (Node) ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Docker ────────────────────────────────────────────────────────────────────
*.pid

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.bak
Thumbs.db
