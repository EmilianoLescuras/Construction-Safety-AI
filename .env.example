# Construction Safety AI — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Backend / API ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Default (no Docker required): SQLite file under outputs/. Override by setting
# DATABASE_URL to the Postgres URL below when docker-compose is up.
# DATABASE_URL=sqlite:///outputs/construction_safety.db

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=construction_safety
POSTGRES_USER=construction_safety
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://construction_safety:change-me@localhost:5432/construction_safety

# ── Redis (event bus / alert queue) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Model / Inference ─────────────────────────────────────────────────────────
MODEL_PATH=models/yolov8n_construction_safety.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DEVICE=mps  # mps | cuda:0 | cpu

# ── Cameras / RTSP ────────────────────────────────────────────────────────────
RTSP_URL_CAM1=rtsp://user:pass@host:554/stream

# ── Alerts ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── MLflow (Phase 12) ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
